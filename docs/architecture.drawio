<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="TaskFlow" version="24.0.0">
  <diagram id="taskflow-arch" name="TaskFlow AWS architecture">
    <mxGraphModel dx="1700" dy="1130" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1130" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="TaskFlow - Secure Serverless Task Management" style="text;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;fontColor=#1F2937;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="900" height="36" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Intended AWS architecture (defined in template.yaml, Stage = dev)" style="text;whiteSpace=wrap;html=1;fontSize=14;fontStyle=0;fontColor=#6B7280;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="900" height="24" as="geometry"/></mxCell>
        <mxCell id="status" value="STATUS: designed and tested locally. NOTHING is deployed to AWS. No AWS resources exist and no AWS account is used." style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fontColor=#92400E;fillColor=#FEF3C7;strokeColor=#D97706;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="92" width="1640" height="34" as="geometry"/></mxCell>
        <mxCell id="z_local" value="YOUR COMPUTER - runs today (local only)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F3FAF3;strokeColor=#2E7D32;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#2E7D32;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="150" width="330" height="500" as="geometry"/></mxCell>
        <mxCell id="z_aws" value="AWS CLOUD (one region, chosen at deploy time) - PLANNED, NOT DEPLOYED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFF8F0;strokeColor=#ED7100;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#ED7100;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="470" y="140" width="1200" height="780" as="geometry"/></mxCell>
        <mxCell id="browser" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Web browser&lt;/b&gt;&lt;/font&gt;&lt;br&gt;React + Vite SPA&lt;br&gt;http://localhost:5173&lt;br&gt;Login / register / task UI&lt;br&gt;Holds Cognito tokens&lt;br&gt;(Cognito SDK, localStorage)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=66;spacingTop=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="270" height="250" as="geometry"/></mxCell>
        <mxCell id="browser_icon" value="WEB" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#2E7D32;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="72" y="212" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="browser_tag" value="RUNS LOCALLY" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="220" y="422" width="100" height="20" as="geometry"/></mxCell>
        <mxCell id="demo" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Demo mode (default)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Fake user, localStorage only&lt;br&gt;Never contacts AWS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=66;spacingTop=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="270" height="140" as="geometry"/></mxCell>
        <mxCell id="demo_icon" value="DEMO" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#2E7D32;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="72" y="492" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="demo_tag" value="NO AWS CALLS" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="220" y="592" width="100" height="20" as="geometry"/></mxCell>
        <mxCell id="cognito" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Amazon Cognito&lt;/b&gt;&lt;/font&gt;&lt;br&gt;User Pool taskflow-dev-users&lt;br&gt;Lite tier, email sign-in&lt;br&gt;App client: SRP flow, no secret&lt;br&gt;Issues ID / access / refresh&lt;br&gt;tokens" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#DD344C;strokeWidth=2.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=66;spacingTop=8;spacingRight=6;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="510" y="180" width="300" height="190" as="geometry"/></mxCell>
        <mxCell id="cognito_icon" value="COG" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DD344C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="522" y="192" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="cognito_tag" value="PLANNED" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="735" y="342" width="65" height="20" as="geometry"/></mxCell>
        <mxCell id="apigw" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;API Gateway (REST)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;taskflow-dev-api, stage dev&lt;br&gt;Cognito authorizer on all&lt;br&gt;four methods (ID token)&lt;br&gt;OPTIONS (CORS) is open&lt;br&gt;Single-origin CORS&lt;br&gt;Throttle 10 req/s, burst 20" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=2.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=66;spacingTop=8;spacingRight=6;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="510" y="450" width="300" height="250" as="geometry"/></mxCell>
        <mxCell id="apigw_icon" value="API" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#8C4FFF;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="522" y="462" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="apigw_tag" value="PLANNED" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="735" y="672" width="65" height="20" as="geometry"/></mxCell>
        <mxCell id="ddb" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Amazon DynamoDB&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Table taskflow-dev-tasks&lt;br&gt;Partition key: userId&lt;br&gt;  (Cognito sub)&lt;br&gt;Sort key: taskId (UUID)&lt;br&gt;On-demand billing&lt;br&gt;Encrypted (AWS-owned key)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#3B48CC;strokeWidth=2.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=66;spacingTop=8;spacingRight=6;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="1400" y="180" width="240" height="230" as="geometry"/></mxCell>
        <mxCell id="ddb_icon" value="DDB" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#3B48CC;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1412" y="192" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="ddb_tag" value="PLANNED" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1565" y="382" width="65" height="20" as="geometry"/></mxCell>
        <mxCell id="cw" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;CloudWatch Logs&lt;/b&gt;&lt;/font&gt;&lt;br&gt;4 log groups&lt;br&gt;/aws/lambda/taskflow-dev-*&lt;br&gt;Retention: 7 days" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=2.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=66;spacingTop=8;spacingRight=6;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="1400" y="490" width="240" height="200" as="geometry"/></mxCell>
        <mxCell id="cw_icon" value="CW" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#E7157B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=18;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1412" y="502" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="cw_tag" value="PLANNED" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1565" y="662" width="65" height="20" as="geometry"/></mxCell>
        <mxCell id="iam" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;IAM - least privilege&lt;/b&gt;&lt;/font&gt;&lt;br&gt;4 execution roles, one per function, each allowing ONE DynamoDB action on the single table ARN (no wildcards):&lt;br&gt;CreateTask: PutItem | ListTasks: Query | UpdateTask: UpdateItem | DeleteTask: DeleteItem&lt;br&gt;Plus AWSLambdaBasicExecutionRole (log writing). API Gateway gets invoke permission per function.&lt;br&gt;No secrets: environment variables are only TABLE_NAME, LOG_LEVEL, ALLOWED_ORIGIN." style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#DD344C;strokeWidth=2.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=66;spacingTop=8;spacingRight=6;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="510" y="745" width="1130" height="150" as="geometry"/></mxCell>
        <mxCell id="iam_icon" value="IAM" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DD344C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="522" y="757" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="iam_tag" value="PLANNED" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1565" y="867" width="65" height="20" as="geometry"/></mxCell>
        <mxCell id="lgroup" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;AWS Lambda x 4&lt;/b&gt;&lt;/font&gt;&lt;br&gt;python3.12, arm64, 128 MB, 10 s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=2.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=66;spacingTop=8;spacingRight=6;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="930" y="180" width="360" height="510" as="geometry"/></mxCell>
        <mxCell id="lgroup_icon" value="λ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=18;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="942" y="192" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="lgroup_tag" value="PLANNED" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1215" y="662" width="65" height="20" as="geometry"/></mxCell>
        <mxCell id="l1" value="&lt;b&gt;POST /tasks&lt;/b&gt;&lt;br&gt;handlers/create_task.py&lt;br&gt;&lt;font color=&quot;#DD344C&quot;&gt;IAM role: dynamodb:PutItem only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF4E8;strokeColor=#ED7100;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="950" y="270" width="320" height="82" as="geometry"/></mxCell>
        <mxCell id="l2" value="&lt;b&gt;GET /tasks&lt;/b&gt;&lt;br&gt;handlers/list_tasks.py&lt;br&gt;&lt;font color=&quot;#DD344C&quot;&gt;IAM role: dynamodb:Query only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF4E8;strokeColor=#ED7100;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="950" y="365" width="320" height="82" as="geometry"/></mxCell>
        <mxCell id="l3" value="&lt;b&gt;PUT /tasks/{taskId}&lt;/b&gt;&lt;br&gt;handlers/update_task.py&lt;br&gt;&lt;font color=&quot;#DD344C&quot;&gt;IAM role: dynamodb:UpdateItem only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF4E8;strokeColor=#ED7100;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="950" y="460" width="320" height="82" as="geometry"/></mxCell>
        <mxCell id="l4" value="&lt;b&gt;DELETE /tasks/{taskId}&lt;/b&gt;&lt;br&gt;handlers/delete_task.py&lt;br&gt;&lt;font color=&quot;#DD344C&quot;&gt;IAM role: dynamodb:DeleteItem only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF4E8;strokeColor=#ED7100;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="950" y="555" width="320" height="82" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="endArrow=block;endFill=1;startArrow=block;startFill=1;strokeColor=#DD344C;strokeWidth=2.5;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;html=1;" edge="1" parent="1" source="browser" target="cognito"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1_n" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;strokeWidth=2.5;fontColor=#DD344C;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="407" y="243.25" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="endArrow=block;endFill=1;strokeColor=#8C4FFF;strokeWidth=2.5;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.45;entryDx=0;entryDy=0;html=1;" edge="1" parent="1" source="browser" target="apigw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2_n" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=2.5;fontColor=#8C4FFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="407" y="462" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="endArrow=block;endFill=1;strokeColor=#DD344C;strokeWidth=2.5;dashed=1;dashPattern=2 5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;html=1;" edge="1" parent="1" source="apigw" target="cognito"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3_n" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;strokeWidth=2.5;fontColor=#DD344C;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="647" y="397" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=2.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;html=1;" edge="1" parent="1" source="apigw" target="lgroup"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4_n" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=2.5;fontColor=#ED7100;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="857" y="504.75" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="e5" value="" style="endArrow=block;endFill=1;strokeColor=#3B48CC;strokeWidth=2.5;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;html=1;" edge="1" parent="1" source="lgroup" target="ddb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5_n" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B48CC;strokeWidth=2.5;fontColor=#3B48CC;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1332" y="275.5" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="e6" value="" style="endArrow=block;endFill=1;strokeColor=#E7157B;strokeWidth=2.5;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;html=1;" edge="1" parent="1" source="lgroup" target="cw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6_n" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=2.5;fontColor=#E7157B;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1332" y="576" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="e7" value="" style="endArrow=block;endFill=1;strokeColor=#DD344C;strokeWidth=2.5;dashed=1;dashPattern=2 5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;html=1;" edge="1" parent="1" source="iam" target="lgroup"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="iam_note" value="assumed by each function" style="text;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fontColor=#DD344C;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1102.5" y="709.5" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="flow" value="&lt;b&gt;Request flow&lt;/b&gt;&lt;br&gt;1  Sign up / sign in with Cognito (SRP). Cognito returns ID, access and refresh tokens to the browser.&lt;br&gt;2  The browser calls the REST API over HTTPS with  Authorization: &amp;lt;ID token&amp;gt;.&lt;br&gt;3  API Gateway's Cognito authorizer validates the token against the user pool. Invalid or missing: 401, no Lambda runs.&lt;br&gt;4  Valid request: API Gateway invokes the Lambda for that route (proxy integration); claims.sub is in the event.&lt;br&gt;5  Lambda uses claims.sub as userId and reads/writes only that user's items in DynamoDB.&lt;br&gt;6  Each Lambda writes logs to its own CloudWatch log group (7-day retention). The response returns the same way." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;spacing=4;" vertex="1" parent="1"><mxGeometry x="30" y="945" width="1040" height="165" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Solid green outline: exists and runs on your computer today (tested)&lt;br&gt;Dashed orange outline: PLANNED, defined in template.yaml, NOT deployed&lt;br&gt;Dotted line: token validation / permission relationship&lt;br&gt;&lt;br&gt;&lt;b&gt;Not part of this design (optional, off by default, not deployed):&lt;/b&gt;&lt;br&gt;WAF, CloudFront, S3 frontend hosting, X-Ray, API Gateway cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;spacing=4;" vertex="1" parent="1"><mxGeometry x="1090" y="945" width="580" height="165" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
