# Copy to .env.local (git-ignored). All values are PUBLIC identifiers - never put secrets here.
#
# DEMO MODE (default, no AWS needed): runs fully in the browser with a fake demo user.
# AWS MODE: set VITE_DEMO_MODE=false and fill in the four values below from the SAM stack
# outputs AFTER you deploy (ApiUrl, UserPoolId, UserPoolClientId) plus your AWS region.
VITE_DEMO_MODE=true

# Base URL including the stage, no trailing slash, e.g. https://abc123.execute-api.eu-west-1.amazonaws.com/dev
VITE_API_URL=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_AWS_REGION=
